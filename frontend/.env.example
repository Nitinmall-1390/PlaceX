# PlaceX Frontend Environment Variables Reference
# Copy this file to frontend/.env for local development

# PlaceX Backend API Base URL
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000

# ─── GOOGLE OAUTH 2.0 (100% FREE) ──────────────────────────────────────────────
# Obtain your free Client ID from Google Cloud Console (OAuth 2.0 Client IDs -> Web application)
# Authorized JavaScript origin: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=

# ─── FIREBASE PHONE AUTHENTICATION (10,000 FREE SMS/MO) ────────────────────────
# From Firebase Console -> Project Settings -> General -> Your apps -> Web config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
