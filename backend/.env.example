# PlaceX Backend Environment Variables Reference
# Copy this file to .env and configure your values

# ─── SERVER CONFIGURATION (REQUIRED) ───────────────────────────────────────────
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/placex
CLIENT_URL=http://localhost:5173

# ─── JWT AUTHENTICATION (REQUIRED) ─────────────────────────────────────────────
# Use two separate, cryptographically secure 256-bit+ random secret strings
JWT_ACCESS_SECRET=your-access-secret-min-32-chars-long-random-string-here
JWT_REFRESH_SECRET=your-different-refresh-secret-min-32-chars-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── GOOGLE GEMINI AI (CONFIGURED) ─────────────────────────────────────────────
# Set your Gemini API key for live AI assistant, ATS recommendations & interview prep
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_RETRIES=2

# ─── FILE UPLOADS (OPTIONAL) ───────────────────────────────────────────────────
# File size limit in megabytes
MAX_FILE_SIZE_MB=5

# ─── CLOUDINARY CDN (OPTIONAL) ────────────────────────────────────────────────
# If left empty, file uploads use secure local disk storage in backend/uploads/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── SMTP TRANSACTIONAL EMAIL (OPTIONAL) ──────────────────────────────────────
# If left empty, outgoing emails log to server console without crashing
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PlaceX <noreply@placex.app>

# ─── JUDGE0 MULTI-LANGUAGE CODE EXECUTION (OPTIONAL) ──────────────────────────
# If unconfigured, JavaScript runs safely in isolated Node VM sandbox
JUDGE0_API_URL=
JUDGE0_API_KEY=

# ─── GOOGLE OAUTH 2.0 (100% FREE - OPTIONAL) ──────────────────────────────────
# Create in Google Cloud Console -> APIs & Services -> Credentials -> OAuth Client ID (Web)
GOOGLE_CLIENT_ID=

# ─── FIREBASE AUTHENTICATION (10,000 FREE SMS/MO - OPTIONAL) ───────────────────
# Place serviceAccountKey.json in backend/config/ if using Firebase Admin for server-side token validation
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json
